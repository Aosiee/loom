# Loom suite TSAN suppressions: races reported inside uninstrumented system
# libraries (glib/fontconfig/gdbus threads spawned by GTK/font init in the
# sandbox) are not loom's. Run the minimal-link TSAN build of loom_tests (cmake -DLOOM_SANITIZE=thread):
#   TSAN_OPTIONS="suppressions=tests/tsan.supp" build-tsan/loom_tests
race:g_malloc
race:g_free
race:g_realloc
race:g_queue_
race:g_strsplit
race:g_dbus
race:fc_
race:Fc
# An exception_ptr's count lives in libstdc++, which is not instrumented, so
# TSAN does not see that the last release, and the exception's destructor and
# free that follow it, come after the other holders' reads of the exception.
race:std::__exception_ptr::exception_ptr::_M_release
race:__cxa_free_exception
race:std::runtime_error::~runtime_error
race:std::logic_error::~logic_error
