# Loom suite TSAN suppressions: races reported inside uninstrumented system
# libraries (glib/fontconfig/gdbus threads spawned by GTK/font init in the
# sandbox) are not loom's. Run the minimal-link loom_tests_tsan binary:
#   TSAN_OPTIONS="suppressions=plugins/engine/loom/tsan.supp" .kiln/out/linux-dev/bin/loom_tests_tsan
race:g_malloc
race:g_free
race:g_realloc
race:g_queue_
race:g_strsplit
race:g_dbus
race:fc_
race:Fc
race:malloc
race:free
